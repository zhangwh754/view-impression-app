# TMDB API Key —— 在 https://www.themoviedb.org/settings/api 免费申请（v3 API Key）
TMDB_API_KEY=

# Vercel Postgres 连接串 —— 在 Vercel 项目 Storage 中创建 Postgres 后自动注入；
# 本地开发可在 Vercel 控制台复制 POSTGRES_URL 到此处
POSTGRES_URL=

# 本机代理（可选）—— 浏览器走代理上网时 Node 服务端也需要它，例如 Clash Verge:
# HTTPS_PROXY=http://127.0.0.1:7897

# —— 登录权限（Auth.js + 谷歌登录）——
# 随机密钥：openssl rand -base64 32 生成
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → 创建 OAuth 客户端 ID (Web)
# 授权回调 URI 填: https://你的域名/api/auth/callback/google (本地开发加 http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 站长谷歌邮箱：只有它能登录并进行写操作，其他人只能浏览
OWNER_EMAIL=
